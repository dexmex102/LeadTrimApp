# ============================================
# LeadTrim AI — Environment Configuration
# ============================================

# Port (optional, defaults to 3000)
PORT=3000

# ============================================
# Lemon Squeezy (Payments + Webhook)
# ============================================

# Your Lemon Squeezy webhook signing secret.
# Found in Lemon Squeezy Dashboard → Settings → Webhooks.
# IMPORTANT: Never commit the real secret. Use this only for local dev.
LEMON_SQUEEZY_WEBHOOK_SECRET=my_super_secret_lemon_123

# Your Lemon Squeezy store URL (used to build checkout links in the Pricing modal).
# Example: https://yourstore.lemonsqueezy.com
# You can find this in your Lemon Squeezy dashboard.
LEMON_SQUEEZY_STORE_URL=https://yourstore.lemonsqueezy.com

# Optional: set to "true" during local testing if you want extra logs
# LEMON_SQUEEZY_TEST_MODE=true
